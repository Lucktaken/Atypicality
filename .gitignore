# 数据文件（大文件隔离）
*.csv
*.tsv
*.parquet
*.db
*.pkl

# 但 studies 下的 results CSV 需要跟踪
!studies/**/results/*.csv

# 模型文件
*.npy
*.model

# data 目录下除 .gitkeep 外全部忽略
data/raw/*
!data/raw/.gitkeep
!data/raw/sciscinet/.gitkeep
!data/raw/datacite/.gitkeep
data/interim/*
!data/interim/.gitkeep

# 但 data/figures 下的样例图需要跟踪
!data/figures/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
colab/

# 项目内部文档
MIGRATION_PLAN.md

# 环境
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

